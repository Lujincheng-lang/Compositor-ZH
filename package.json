{
  "name": "compositor-win-zh",
  "version": "0.1.0",
  "description": "Compositor Windows 中文图像编辑器",
  "author": "Compositor Windows contributors",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "electron .",
    "test": "node tests/smoke.cjs",
    "dist:win": "npm run build && electron-builder --win dir",
    "dist:installer": "npm run build && electron-builder --win nsis --config.directories.output=release/installer-build"
  },
  "dependencies": {
    "ag-psd": "^29.0.0",
    "jszip": "^3.10.1",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.12",
    "playwright": "^1.56.0",
    "prettier": "^3.9.9",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "org.compositor.windows.zh",
    "productName": "Compositor 中文版",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "LICENSE*",
      "docs/**/*"
    ],
    "win": {
      "target": "dir",
      "signExecutable": false,
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Compositor-ZH-${version}-Setup.${ext}",
      "installerLanguages": ["zh_CN", "en_US"],
      "displayLanguageSelector": false
    },
    "asar": true
  }
}
